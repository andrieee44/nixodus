%{
#define _GNU_SOURCE
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
%}

struct bin_entry {
    const char *name;
    const char *path;
};

%struct-type
%define lookup-function-name bin_lookup
%define hash-function-name bin_hash
%compare-lengths
%readonly-tables

%%
{{ GPERF KEY-VALUES }}%%

static const char *const binaries[] = {
    {{ GPERF KEYS }}
};

static void print_usage() {
    size_t i;

    fputs("Usage: nixodus-packages <BINARY> [ARG]...\n", stderr);
    fputs("       <BINARY> [ARG]...\n\n", stderr);
    fputs("Binaries:\n", stderr);

    for (i = 0; i < sizeof(binaries) / sizeof(binaries[0]); i++) {
        fprintf(stderr, "  %s\n", binaries[i]);
    }
}

int main(int argc, char **argv) {
    char *bin, **new_argv;
    const struct bin_entry *entry;

    bin = basename(argv[0]);
    new_argv = argv;

    if (strcmp(bin, "nixodus-packages") == 0) {
        if (argc < 2) {
            print_usage();

            return 1;
        }

        bin = argv[1];
        new_argv = &argv[1];
    }

    entry = bin_lookup(bin, strlen(bin));
    if (entry == NULL) {
        fprintf(stderr, "nixodus-packages: unknown binary %s\n", bin);
        print_usage();

        return 1;
    }

    execv(entry->path, new_argv);
    perror("nixodus-packages: execv");

    return 1;
}
